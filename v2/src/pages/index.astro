---
import Site from '../layouts/Site.astro';
import CareerTrajectory from '../components/CareerTrajectory.astro';
import PublicationList from '../components/PublicationList.astro';
import ResearchWorkflow from '../components/ResearchWorkflow.astro';
import EvidencePanel from '../components/EvidencePanel.astro';
import { researchLifecycle } from '../data/workflows';
import { pillars, url } from '../data/site';

---
<Site title="Paramita Chatterjee, PhD, MBA, PMP | Bench2Bytes">
 <div class="field-notebook"><section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy"><p class="eyebrow">FROM THE BENCH / INTO THE DATA</p>
   <p class="credential-name">Paramita Chatterjee, <span>PhD, MBA, PMP</span></p>
   <h1 id="hero-title"><span>Science.</span><span>Data.</span><span>Decisions<span class="accent">.</span></span></h1>
   <p class="professional-identity">Scientific Research &amp; Innovation Leader</p>
   <p class="specialties">AI &amp; Data · Precision Medicine · Real-World Evidence · Genomics · Research Strategy</p>
   <p class="hero-intro">A dataset makes more sense when you understand where the biology begins. My work connects experimental biology, genomics, cell-therapy research and oncology evidence.</p>
   <p class="fine">Director, Research Projects · Emory University School of Medicine</p>
   <div class="actions"><a class="button" href={url('projects.html')}>Explore the research <span aria-hidden="true">↗</span></a><a class="text-link" href={url('about.html')}>About Paramita →</a></div>
  </div>
  <div class="hero-portrait"><img src={url('images/profile.jpeg')} alt="Paramita Chatterjee" width="420" height="420" /><p>Paramita Chatterjee / Science × technology × business</p></div>
 </section>
 <section class="section" id="projects"><div class="section-heading"><p class="eyebrow">From the research</p><h2>What can a single cell tell us<br />about a clinical trial?</h2><a class="text-link" href={url('projects.html')}>All research &amp; projects →</a></div>
  <article class="featured-work"><div><span class="tag">SINGLE-CELL · CLINICAL RESEARCH</span><h3>Inside the immune biology of knee osteoarthritis</h3><p>My contribution: analytical strategy, pipeline development and biological interpretation. The broader clinical-trial omics programs encompassed 500+ samples across cell-therapy products.</p><a class="text-link" href={url('projects/details/Project1.html')}>View the research →</a><p class="fine">MILES · Cell characterization · Single-cell and multi-omics</p></div><figure><img src={url('projects/images/Project1_Picture1.jpg')} alt="Scientific overview of the knee osteoarthritis single-cell study; full detail available in the linked abstract" width="640" height="640" loading="lazy" /><figcaption>Fig. 1 / Single-cell transcriptome and crosstalk analysis in knee osteoarthritis. Open the original abstract for the scientific context.</figcaption></figure></article>
  <div class="editorial-row"><span class="tag">AI-ENABLED RESEARCH TOOL</span><h3>Oncology Research Writing Tools</h3><p>An existing writing resource in the Bench2Bytes portfolio. Explore the tool directly for its current functionality and documentation.</p><a class="text-link" href="https://pchatterjee7.github.io/research-tools">Explore the tool ↗</a></div>
 </section>
 <section class="rwe-letter"><p class="notebook-label">A different scale. The same attention to context.</p><div><h2>How do you construct recurrence evidence from longitudinal oncology records?</h2><aside><p class="study-number">942,124 <span>patients in the study population</span></p><p>Breast cancer real-world data brings another kind of complexity: endpoints, treatment sequences, competing risks and misclassification.</p><p>Corresponding author · Retrospective RWD study · Manuscript in preparation</p><a class="text-link" href={url('projects.html#oncology-rwe')}>Inside the oncology RWE case →</a></aside></div></section>
 <section class="section" id="about"><div class="section-heading"><p class="eyebrow">Four connected perspectives</p><h2>The disciplines<br />travel together.</h2></div>
  <div class="pillar-list">{pillars.map(p => <a class="pillar" href={url(p.href)}><span class="number">{p.number}</span><div><h3>{p.title}</h3><p>{p.text}</p></div><span class="arrow" aria-hidden="true">↗</span></a>)}</div>
 </section>
 <section class="section" id="publications"><div class="section-heading"><p class="eyebrow">Recent papers</p><h2>On the record.</h2><a class="text-link" href={url('publications.html')}>Explore publications →</a></div><PublicationList limit={3} /></section>
 <section class="section"><div class="section-heading"><p class="eyebrow">A working perspective</p><h2>Follow the question.<br />Keep the context.</h2><p>Science × Technology × Business × Program Leadership</p></div><ResearchWorkflow id="research-lifecycle" title="From scientific question to informed decision" stages={researchLifecycle} stewardship />
 <a class="text-link" href={url('research-models.html')}>Explore research models →</a><p class="notebook-footnote">A career record of 18+ peer-reviewed publications. Contributed to securing $3.5M in awarded research funding: $1.8M MILES and $1.7M NIH-RMIP-IDCCH.</p><a class="text-link" href={url('about.html')}>Career progression &amp; credentials →</a> · <a class="text-link" href={url('leadership.html')}>Leadership &amp; contribution context →</a></section>
 <section class="section"><div class="section-heading"><p class="eyebrow">In the margins / writing</p><h2>More UMAP clusters.<br />More cell types?</h2><a class="text-link" href={url('talks-writing.html')}>Explore talks &amp; writing →</a></div><div class="writing-links"><a href={url('blog-2025-03-18-SingleCellClustering.html')}><span class="eyebrow">MARCH 18, 2025 · SCIENTIFIC WRITING</span><h3>Why more UMAP clusters don’t mean more cell types</h3></a><a href={url('presentations.html')}><span class="eyebrow">PRESENTATIONS &amp; WEBINARS</span><h3>Scientific work in conversation</h3></a></div></section>
</div></Site>
