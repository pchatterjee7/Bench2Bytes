---
import PortfolioCases from '../components/PortfolioCases.astro';
import PublicationList from '../components/PublicationList.astro';
import preprints from '../data/preprints.json';
import Site from '../layouts/Site.astro'; import legacy from '../data/legacy.json'; import { url } from '../data/site';
export function getStaticPaths() { return legacy.map(page => ({ params: { legacy: page.slug }, props: { page } })); }
const { page } = Astro.props;
const research = page.slug === 'projects';
const heading = page.project ? page.originalHeading : page.slug === 'publications' ? 'Publications' : page.slug === 'presentations' ? 'Presentations & Webinars' : '';
const originalBody = research ? page.body.replace('<h1>Research Projects</h1>', '<h2>Scientific figures, abstracts &amp; tools</h2>').replace(/<!-- COST Covid-19 Severity Prediction Tool -->[\s\S]*?<\/div>/, '').replace('Runs entirely in the browser with no data collection.','Explore the tool and repository for current functionality.') : page.slug === 'presentations' ? page.body.replace(/<a[^>]*href="https:\/\/example.com[^"]*"[^>]*>[\s\S]*?<\/a>/g,'').replace('\"Bioinformatics and Therapeutic Genomics\"','\"Transcriptomics Investigation Of Multi-Site and Multi-Tissue Derived Cell Therapy Products In Clinical Applications for Osteoarthritis\"') : page.body;
const body = page.slug === 'blog' ? `<section class="section prose"><p class="eyebrow">OCTOBER 5, 2026 · AI GOVERNANCE</p><h2><a href="${url('blog-2026-10-05-AIGovernance.html')}">AI governance in biomedical research</a></h2><p>Evidence, oversight and responsibility in genetics, diagnostics, therapies and clinical trials.</p><p><a href="${url('governance-observatory.html')}">Explore the companion AI Governance Observatory →</a></p></section>` + originalBody : originalBody;
---
<Site title={page.title} historical={page.historical}>
 {research && <><div class="page-heading"><p class="eyebrow">RESEARCH</p><h1>An expanding portfolio.<br />An enduring foundation.</h1><p class="lede">Science → data → evidence → decisions. Explore the questions, methods and contributions behind the work.</p></div><nav class="research-jump" aria-label="Portfolio cases">{[['RWE','oncology-rwe'],['Oncology data','multimodal-oncology'],['Cell therapy & omics','cell-therapy'],['Public health genomics','public-health'],['Program leadership','program-leadership']].map(([label,id]) => <a href={'#'+id}>{label}</a>)}</nav><span id="clinical-evidence"></span><PortfolioCases /><p><a class="text-link" href={url('research-models.html')}>Professional operating model →</a></p></>}
 {research && <section class="section prose" id="clinical-ai"><h2>Coursework &amp; exploratory tools</h2><p><a href="https://github.com/pchatterjee7/COST-Covid19-Severity-Prediction-Tool">COST — COVID-19 severity prediction tool</a> · Collaborative class project (2021), with Mariam Nawaz and Neharika Bhatia. An exploratory machine-learning exercise using single-cell transcriptome data.</p></section>}
 {page.project && <p class="breadcrumbs"><a href={url('projects.html')}>← All research</a></p>}
 {heading && <div class="page-heading"><p class="eyebrow">{page.project ? 'RESEARCH / ORIGINAL ABSTRACT' : 'SCIENTIFIC RECORD'}</p><h1>{heading}</h1></div>}
 {page.slug === 'publications' ? <section id="publications"><p class="lede">Selected published research across genomics, cell therapy and translational science.</p><nav class="research-jump" aria-label="Publication sections"><a href="#published">Published</a><a href="#preprints">Preprints</a><a href="#abstracts">Selected abstracts &amp; presentations</a></nav><h2 id="published">Published</h2><PublicationList /><section class="section" id="preprints"><h2>Preprints</h2><p>Research posted on bioRxiv; listed separately from peer-reviewed publications.</p><ul class="publication-list">{preprints.map(p => <li><span class="eyebrow">{p.year} · bioRxiv · PREPRINT</span><h3><a href={`https://doi.org/${p.doi}`}>{p.title}</a></h3><p class="publication-authors">{p.authors.split(/(Paramita Chatterjee)/g).map(a => a === 'Paramita Chatterjee' ? <strong>{a}</strong> : a)}</p><a class="text-link" href={`https://doi.org/${p.doi}`}>DOI: {p.doi} ↗</a></li>)}</ul></section><section class="section" id="abstracts"><h2>Selected abstracts &amp; presentations</h2><ul><li>Single-cell transcriptomics comparison of cell therapeutics in osteoarthritis · ISCT, Paris · 2023.</li><li>High-dimensional multi-omics comparison of cells in bone marrow in osteoarthritis · ISCT, San Francisco · 2022.</li><li>Transcriptomics investigation of multi-site and multi-tissue derived cell therapy products · CMAT, UGA · 2024.</li></ul><a class="text-link" href={url('presentations.html')}>Presentations &amp; webinars →</a></section></section> : <div class:list={['legacy-content', { 'prose': page.historical, 'research-index': research }]} id={research ? 'research-inventory' : undefined} set:html={body} />}
 {page.project && <section class="section prose"><h2>Explore the wider scientific context</h2><p>These original figures and abstracts sit within a broader portfolio of experimental, genomic and computational research.</p><a class="text-link" href={url('projects.html#cell-therapy')}>Single-cell &amp; multi-omics portfolio case →</a><br /><a class="text-link" href={url('publications.html')}>Related scientific record →</a></section>}
</Site>
