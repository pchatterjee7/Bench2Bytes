---
import Site from '../layouts/Site.astro';
import entries from '../data/governance/entries.json';
import { url } from '../data/site';
const sectors=[...new Set(entries.flatMap(e=>e.sectors))].sort();
const statuses=[...new Set(entries.map(e=>e.currentStatus))].sort();
const jurisdictions=[...new Set(entries.map(e=>e.jurisdiction))].sort();
---
<Site title="AI Governance Observatory | Bench2Bytes" description="A curated source directory for AI governance in genetics, biomedical research, diagnostics, therapies and clinical trials.">
<div class="page-heading"><p class="eyebrow">BENCH2BYTES / SOURCE DIRECTORY</p><h1>AI Governance Observatory</h1><p class="lede">Find governance documents relevant to biomedical research. Filter by sector, jurisdiction and document status.</p><a class="text-link" href={url('blog-2026-10-05-AIGovernance.html')}>Read the accompanying article →</a></div>
<p class="scope">Initial collection · {entries.length} primary-source records · Editorial review: October 5, 2026. Coverage is curated, with emphasis on US and EU biomedical research. Source checks and substantive updates are recorded separately.</p>
<form id="filters" class="filters" role="search" aria-label="Filter governance sources">
<label>Search<input id="search" type="search" placeholder="Organization, topic or document" /></label>
<label>Sector<select id="sector"><option value="">All sectors</option>{sectors.map(s=><option>{s}</option>)}</select></label>
<label>Document status<select id="status"><option value="">All statuses</option>{statuses.map(s=><option>{s}</option>)}</select></label>
<label>Jurisdiction<select id="jurisdiction"><option value="">All jurisdictions</option>{jurisdictions.map(s=><option>{s}</option>)}</select></label>
<button type="reset">Reset filters</button>
</form>
<p id="result-count" role="status" aria-live="polite">{entries.length} documents</p>
<p id="empty" hidden>No documents match these filters. Try a broader search or reset the filters.</p>
<div id="records">{entries.map(e=><article class="record" data-search={[e.title,e.issuingOrganization,e.summary,e.implication,...e.sectors].join(' ').toLowerCase()} data-sectors={JSON.stringify(e.sectors)} data-status={e.currentStatus} data-jurisdiction={e.jurisdiction}>
<p class="eyebrow">{e.issuingOrganization} · {e.jurisdiction}</p><h2><a href={e.source}>{e.title} ↗</a></h2><p class="record-status">{e.currentStatus} <span>· {e.documentType}</span></p><p>{e.summary}</p><p><strong>Research relevance:</strong> {e.implication}</p><ul class="sector-tags" aria-label="Applicable sectors">{e.sectors.map(s=><li>{s}</li>)}</ul><p class="verification">Instrument/document published: {e.documentPublished}{e.documentPublishedNote && ` · ${e.documentPublishedNote}`}<br />Source page updated: {e.sourcePageUpdated ?? 'Not stated / not established'}<br />Editorial verification: {e.editorialVerified}</p><p class="verification">Source: {e.sourceOrganization} · {e.sourcePageType}</p>{e.primaryDocuments.length > 0 && <ul>{e.primaryDocuments.map(d => <li><a href={d.url}>{d.title} ↗</a></li>)}</ul>}<details><summary>Record history</summary><ul>{e.history.map(h=><li>{h.date} · {h.note}</li>)}</ul></details>
</article>)}</div>
<section class="section prose"><h2>Coverage and update method</h2><p>This collection includes official regulatory, funder and framework sources. It does not claim exhaustive coverage. Company commitments and institutional initiatives can be added as distinct record types after source review.</p><p>Scheduled weekly monitoring runs through a local Codex desktop workflow and depends on that scheduler being active. The public website does not run monitoring. Checks distinguish landing-page changes, linked primary-document changes and newly discovered documents; each is a review signal, not a substantive policy or status determination. Substantive summaries, status changes and interpretations require editorial review. An inaccessible source retains its previous record and is flagged in the review report.</p><p>“Editorial verification” means the source and interpretation were reviewed. It is not the document’s effective date. Follow the source for the full text and current applicability.</p><a href={url('governance-data.json')} download>Download the source directory (JSON)</a></section>
</Site>
<script>
 const form=document.querySelector<HTMLFormElement>('#filters')!;
 const search=document.querySelector<HTMLInputElement>('#search')!;
 const sector=document.querySelector<HTMLSelectElement>('#sector')!;
 const status=document.querySelector<HTMLSelectElement>('#status')!;
 const jurisdiction=document.querySelector<HTMLSelectElement>('#jurisdiction')!;
 const records=[...document.querySelectorAll<HTMLElement>('.record')];
 function filter(){let count=0;const q=search.value.trim().toLowerCase();for(const r of records){const shown=(!q||r.dataset.search!.includes(q))&&(!sector.value||JSON.parse(r.dataset.sectors!).includes(sector.value))&&(!status.value||r.dataset.status===status.value)&&(!jurisdiction.value||r.dataset.jurisdiction===jurisdiction.value);r.hidden=!shown;if(shown)count++;}document.querySelector('#result-count')!.textContent=`${count} of ${records.length} documents`;document.querySelector<HTMLElement>('#empty')!.hidden=count!==0;}
 form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('input',filter);form.addEventListener('change',filter);form.addEventListener('reset',()=>setTimeout(filter,0));
</script>
<style>.scope,.verification{font-size:.85rem;color:var(--muted)}.filters{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:1rem;border-block:1px solid var(--line);padding:1.5rem 0;margin-top:2rem}.filters label{display:grid;gap:.5rem;font-size:.85rem}.filters input,.filters select,.filters button{font:inherit;padding:.65rem;background:var(--paper,#fff);color:inherit;border:1px solid var(--line);width:100%;min-width:0}.filters button{width:auto;justify-self:start;cursor:pointer}.record{padding:1.8rem 0;border-bottom:1px solid var(--line);max-width:85ch}.record[hidden]{display:none}.record h2{font-size:1.35rem;margin:.4rem 0}.record-status{font-weight:600}.record-status span{font-weight:400}.sector-tags{display:flex;flex-wrap:wrap;gap:.4rem;list-style:none;padding:0}.sector-tags li{font-size:.75rem;padding:.2rem .5rem;border:1px solid var(--line)}details{font-size:.85rem}summary{cursor:pointer}input:focus-visible,select:focus-visible,button:focus-visible,summary:focus-visible{outline:2px solid currentColor;outline-offset:3px}@media(max-width:850px){.filters{grid-template-columns:1fr 1fr}}@media(max-width:500px){.filters{grid-template-columns:1fr}}</style>
