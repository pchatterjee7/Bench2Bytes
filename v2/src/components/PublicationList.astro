---
import bibliography from '../data/bibliography.json';
interface Props { limit?: number; }
const { limit } = Astro.props;
const records = limit ? bibliography.slice(0,limit) : bibliography;
const emphasize = (authors: string) => authors.split(/(Paramita Chatterjee)/g);
---
<ul class="publication-list">{records.map(p => <li><span class="eyebrow">{p.year} · {p.journal}</span><h3><a href={`https://doi.org/${p.doi}`}>{p.title}</a></h3>{p.dateNote && <p class="fine">{p.dateNote}</p>}<p class="publication-authors">{emphasize(p.authors).map(a => a === 'Paramita Chatterjee' ? <strong>{a}</strong> : a)}</p><a class="text-link" href={`https://doi.org/${p.doi}`}>DOI: {p.doi} ↗</a></li>)}</ul>
