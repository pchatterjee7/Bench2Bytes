---
import cases from '../data/cases.json';
import { url } from '../data/site';
---
<div class="portfolio-cases">{cases.map(c => <article id={c.id} class="portfolio-case"><p class="tag">{c.domain}</p><h2>{c.title}</h2><p class="lede">{c.summary}</p><details><summary>Explore context, contribution &amp; evidence <span aria-hidden="true">+</span></summary><dl class="case-study-fields">{c.fields.map(([label,content],i) => <div><dt><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span>{label}</dt><dd>{content}</dd></div>)}</dl><p class="related-links">{c.links.map(([label,href]) => <a class="text-link" href={href.startsWith('https://') ? href : url(href)}>{label} →</a>)}</p></details></article>)}</div>
