---
import EvidenceFlow from './EvidenceFlow.astro';
import cases from '../data/cases.json';
import { url } from '../data/site';
---
<div class="portfolio-cases">{cases.map((c,i) => <article id={c.id} class="portfolio-case"><p class="tag"><span class="case-number">{String(i+1).padStart(2,"0")} / </span>{c.domain}</p><h2>{c.title}</h2><p class="lede">{c.summary}</p>{i===0 && <p class="case-scale">942,124 patients · EHR + claims · recurrence · survival</p>}{i===1 && <p class="case-scale">Molecular · clinical · registry · imaging · biomarkers</p>}{i===2 && <p class="case-scale">Research objectives · data readiness · analytical priorities</p>}<details><summary>Explore context, contribution &amp; evidence <span aria-hidden="true">+</span></summary>{c.id==="oncology-rwe" && <EvidenceFlow kind="rwe" />}{c.id==="ai-enabled-research" && <EvidenceFlow kind="ai" />}<dl class="case-study-fields">{c.fields.map(([label,content],i) => <div><dt><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span>{label}</dt><dd>{content}</dd></div>)}</dl><p class="related-links">{c.links.map(([label,href]) => <a class="text-link" href={href.startsWith('https://') ? href : url(href)}>{label} →</a>)}</p></details></article>)}</div>
