---
import { url } from "../data/site";
interface Stage { title: string; description: string; example?: string; href?: string; }
interface Props { title: string; stages: Stage[]; stewardship?: boolean; id: string; }
const { title, stages, stewardship = false, id } = Astro.props;
---
<figure class="research-workflow" aria-labelledby={`${id}-title`}>
 <figcaption id={`${id}-title`} class="workflow-caption"><span class="eyebrow">PROFESSIONAL OPERATING MODEL</span><strong>{title}</strong><span>A way of connecting disciplines, methods and decisions.</span></figcaption>
 <ol class="workflow-stages" style={`--stage-count:${stages.length}`}>
  {stages.map((stage, i) => <li><details><summary><span class="workflow-index" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><span>{stage.title}</span><span class="workflow-detail-hint">Explore stage <span aria-hidden="true">+</span></span></summary><p>{stage.description}</p>{stage.example && <p class="fine"><strong>From my work</strong><br />{stage.example}</p>}{stage.href && <p><a class="text-link" href={url(stage.href)}>Explore the career example →</a></p>}</details></li>)}
 </ol>
 {stewardship && <div class="stewardship"><span class="stewardship-label">Across Science → Data → AI / computation → Evidence → Decisions</span><p>Stewardship &amp; responsible use</p><span>Provenance · Validation · Privacy · Quality · Accountability</span></div>}
</figure>
